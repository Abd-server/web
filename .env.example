# انسخ هذا الملف إلى .env واملأ القيم. لا ترفع .env على GitHub أبداً.

# ولّد سرّاً قوياً:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ضع_السرّ_المولّد_هنا

# SQLite للتجربة الآن. للإنتاج (القطعة 3) غيّرها إلى PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/kiln_platform
DATABASE_URL=sqlite:///./demo.db
